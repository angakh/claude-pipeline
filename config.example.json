{
  "$comment": "Example config for the Scroobious project. Generated by pipeline-init, or copy this file to .claude/delivery-pipeline.config.json in your project and edit by hand. See config.schema.json for what every field means.",
  "sweep": {
    "maxTicketsPerRun": 5,
    "maxConcurrentAgents": 2
  },
  "jira": {
    "cloudId": "scroobious-15765695.atlassian.net",
    "projectKey": "SCR",
    "toDoStatus": "To Do",
    "planReviewStatus": "In Review",
    "buildStatus": "In Progress",
    "qaStatus": "Re-Test",
    "doneStatus": "Done"
  },
  "git": {
    "trunkBranch": "master",
    "branchPrefix": "feature/",
    "oneCommitPerBranch": true,
    "remote": "origin"
  },
  "dev": {
    "startCommands": ["cd api && yarn start:api:dev", "yarn dev"],
    "localUrl": "http://localhost:3000",
    "readyCheckCommand": "curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:5001/graphql -H 'content-type: application/json' -d '{\"query\":\"{__typename}\"}'",
    "testCommand": "yarn test"
  },
  "db": {
    "mode": "direct-readonly",
    "renderPostgresId": "REPLACE_WITH_RENDER_POSTGRES_ID",
    "restoreRunbookPath": "docs/quicklogin-after-prod-restore.md"
  },
  "qa": {
    "maxCycles": 3,
    "testAccountStrategy": "yarn ensure:quicklogin (staging-gated helper) — see restoreRunbookPath for the manual 3-step fix after a fresh prod restore"
  },
  "pr": {
    "autoCreate": true
  },
  "notifications": {
    "channel": "push"
  }
}
